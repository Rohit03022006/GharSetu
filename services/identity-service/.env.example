# Identity Service Environment Variables

PORT=4001
NODE_ENV=development

# Database Connection (PostgreSQL - dedicated identity_db)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/identity_db?schema=public"

# JWT Configuration
JWT_SECRET="gharsetu-super-secret-jwt-access-key-2026"
JWT_REFRESH_SECRET="gharsetu-super-secret-jwt-refresh-key-2026"

# Default Initial Admin Credentials
DEFAULT_ADMIN_EMAIL="[EMAIL_ADDRESS]"
DEFAULT_ADMIN_PASSWORD="[PASSWORD]"

# SMTP Email
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4001/auth/google/callback"
