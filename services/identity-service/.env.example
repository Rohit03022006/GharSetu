# Identity Service Environment Variables

PORT=4001
NODE_ENV=development

# Database Connection (PostgreSQL - dedicated identity_db)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/identity_db?schema=public"

# JWT Configuration
JWT_SECRET="your-256-bit-jwt-access-secret"
JWT_REFRESH_SECRET="your-256-bit-jwt-refresh-secret"
INTERNAL_SERVICE_KEY="your-internal-microservice-secret-key"

# Default Initial Admin Credentials
DEFAULT_ADMIN_EMAIL="admin@gharsetu.com"
DEFAULT_ADMIN_PASSWORD="AdminPassword123!"

# SMTP Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4001/auth/google/callback"
